# Example: nginx in front of Node (port 4000) on aaaurrrssimpire.org
# Place in /etc/nginx/sites-available/ and symlink to sites-enabled.

server {
    listen 80;
    server_name aaaurrrssimpire.org www.aaaurrrssimpire.org;
    return 301 https://www.aaaurrrssimpire.org$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.aaaurrrssimpire.org;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
