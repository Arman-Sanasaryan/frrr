PORT=4000
SQLITE_PATH=
JWT_SECRET=replace-with-strong-jwt-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
VAPID_SUBJECT=mailto:test@example.com
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
PUBLIC_BASE_URL=http://localhost:3001
STATIC_BASE_URL=http://localhost:3001

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev (API on port 4000):
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Production URLs — see server/.env.production.example

# Crypto checkout (replace with your wallet addresses)
CRYPTO_WALLET_BTC=bc1qyour_bitcoin_address
CRYPTO_WALLET_ETH=0xYourEthereumAddress
CRYPTO_WALLET_USDT=TYourTronUsdtAddress
CRYPTO_RATE_BTC=6500000
CRYPTO_RATE_ETH=350000
CRYPTO_RATE_USDT=92
